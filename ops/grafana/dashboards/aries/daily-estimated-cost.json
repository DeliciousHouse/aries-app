{
  "__inputs": [
    { "name": "DS_ARIES_POSTGRES", "label": "Aries PostgreSQL (read-only)", "type": "datasource", "pluginId": "grafana-postgresql-datasource", "pluginName": "PostgreSQL" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Estimated AI cost per tenant / UTC day — $100/day reference",
      "description": "Reported cost estimates only, not billing or invoices. Includes failed and retry attempts. Missing costs are not zero: a subtotal below $100 cannot establish compliance when tasks without cost > 0. Days begin at UTC midnight; the final day is partial through the selected end time. No rows means no retained AI telemetry, not no spend. Unscoped work and non-AI engines are excluded.",
      "type": "table",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_ARIES_POSTGRES}" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  date_trunc('day', started_at AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS time,\n  tenant_id,\n  sum(cost_cents) / 100.0 AS estimated_cost_usd,\n  count(*) AS ai_tasks,\n  count(*) FILTER (WHERE cost_cents IS NULL) AS tasks_without_cost,\n  100.0 AS daily_reference_usd\nFROM task_execution_log\nWHERE execution_engine = 'AI_LLM'\n  AND tenant_id IS NOT NULL\n  AND started_at >= (date_trunc('day', $__timeFrom()::timestamptz AT TIME ZONE 'UTC') AT TIME ZONE 'UTC')\n  AND started_at < $__timeTo()::timestamptz\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "time" }, "properties": [{ "id": "displayName", "value": "UTC day" }, { "id": "unit", "value": "time:YYYY-MM-DD" }] },
          { "matcher": { "id": "byName", "options": "tenant_id" }, "properties": [{ "id": "displayName", "value": "Tenant" }, { "id": "decimals", "value": 0 }] },
          {
            "matcher": { "id": "byName", "options": "estimated_cost_usd" },
            "properties": [
              { "id": "displayName", "value": "Reported estimated AI cost (USD)" },
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 4 },
              { "id": "noValue", "value": "Not reported" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "red", "value": 100 }] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "ai_tasks" }, "properties": [{ "id": "displayName", "value": "AI attempts (including failures/retries)" }, { "id": "decimals", "value": 0 }] },
          {
            "matcher": { "id": "byName", "options": "tasks_without_cost" },
            "properties": [
              { "id": "displayName", "value": "AI attempts without cost (unknown)" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 1 }] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "daily_reference_usd" }, "properties": [{ "id": "displayName", "value": "$100/day reference (USD)" }, { "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["aries", "cost-estimates", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-7d/d", "to": "now" },
  "timezone": "utc",
  "title": "Aries Daily Estimated AI Cost",
  "uid": "aries-daily-estimated-cost",
  "version": 1
}
