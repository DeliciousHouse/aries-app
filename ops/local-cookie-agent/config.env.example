# local-cookie-agent config. Copy to config.env (chmod 600) and edit.
# NO SECRETS BELONG IN THIS FILE — credentials live in Bitwarden, cookies live
# in the browser profile and the staging dir. This is addresses and paths only.

# The VM, by tailnet IP (not a public DNS name — the payload must ride WireGuard).
VM_SSH_TARGET="node@100.65.234.31"

# Drop-box and prober state on the VM.
VM_INBOX="/home/node/.agent-reach-inbox"
VM_PROBER_STATE="/home/node/.local/state/agent-reach-prober/state.json"

# gpg recipient = the VM-only key. See gpg-setup.md.
GPG_RECIPIENT="aries-cookie-vm"

# Local staging dir holding per-platform cookie fragments (0700).
STAGING_DIR="$HOME/.aries-cookies"

# Platforms to keep alive. Must match ARINGEST_PLATFORMS / ARPROBE_PLATFORMS
# on the VM, or a full snapshot here will look partial there.
PLATFORMS="twitter reddit instagram facebook"

# Bitwarden item names, one per platform: "$BW_ITEM_PREFIX$platform".
BW_ITEM_PREFIX="aries-throwaway-"

# Dedicated browser profile used ONLY for the throwaway accounts.
BROWSER_PROFILE="$HOME/.config/chromium-aries-throwaway"
