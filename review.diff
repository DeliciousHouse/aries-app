+    if (sql.includes('FROM oauth_connections')) return { rows: [{ id: '19', tenant_id: '75', provider: 'meta_ads', status: 'connected', external_account_id: selected, granted_scopes: ['ads_read', 'ads_management'] }], rowCount: 1 };
