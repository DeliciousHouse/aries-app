{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video_runtime_state_schema.v1.json",
  "title": "Video Runtime State Schema v1 (Hermes Execution)",
  "description": "Canonical Aries state for a provider-neutral video render submitted to Hermes. Downstream provider state remains internal to Hermes.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "job_id",
    "tenant_id",
    "execution_provider",
    "run_status",
    "current_phase",
    "created_at",
    "updated_at",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1"
    },
    "record_type": {
      "type": "string",
      "const": "video_runtime_state"
    },
    "job_id": {
      "$ref": "#/$defs/uuid"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$"
    },
    "execution_provider": {
      "type": "string",
      "const": "hermes"
    },
    "hermes_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "run_status": {
      "type": "string",
      "enum": [
        "active",
        "terminal"
      ]
    },
    "current_phase": {
      "$ref": "#/$defs/runtimePhase"
    },
    "created_at": {
      "$ref": "#/$defs/isoDateTime"
    },
    "updated_at": {
      "$ref": "#/$defs/isoDateTime"
    },
    "last_heartbeat_at": {
      "$ref": "#/$defs/isoDateTime"
    },
    "progress_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/stateTransition"
      }
    },
    "result": {
      "$ref": "#/$defs/resultEnvelope"
    },
    "error": {
      "$ref": "#/$defs/errorEnvelope"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "runtimePhase": {
      "type": "string",
      "enum": [
        "submitted",
        "accepted",
        "rendering",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "stateTransition": {
      "type": "object",
      "required": [
        "from_phase",
        "to_phase",
        "changed_at",
        "actor"
      ],
      "properties": {
        "from_phase": {
          "$ref": "#/$defs/runtimePhase"
        },
        "to_phase": {
          "$ref": "#/$defs/runtimePhase"
        },
        "changed_at": {
          "$ref": "#/$defs/isoDateTime"
        },
        "actor": {
          "type": "string",
          "enum": [
            "aries",
            "hermes",
            "operator"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "properties": {
              "from_phase": {
                "enum": [
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              },
              "to_phase": {
                "not": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                }
              }
            },
            "required": [
              "from_phase",
              "to_phase"
            ]
          }
        }
      ]
    },
    "videoArtifact": {
      "type": "object",
      "required": [
        "uri",
        "mime_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "mime_type": {
          "type": "string",
          "const": "video/mp4"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "resultEnvelope": {
      "type": "object",
      "required": [
        "artifacts",
        "created_at"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/videoArtifact"
          }
        },
        "created_at": {
          "$ref": "#/$defs/isoDateTime"
        }
      },
      "additionalProperties": false
    },
    "errorEnvelope": {
      "type": "object",
      "required": [
        "code",
        "message",
        "captured_at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "retryable": {
          "type": "boolean"
        },
        "captured_at": {
          "$ref": "#/$defs/isoDateTime"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "current_phase": {
            "const": "succeeded"
          }
        },
        "required": [
          "current_phase"
        ]
      },
      "then": {
        "properties": {
          "run_status": {
            "const": "terminal"
          }
        },
        "required": [
          "result"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "current_phase": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "current_phase"
        ]
      },
      "then": {
        "properties": {
          "run_status": {
            "const": "terminal"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  ]
}
